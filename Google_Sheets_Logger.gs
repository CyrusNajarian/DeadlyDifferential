// Bound to the private Google Sheet. Deploy as Me, accessible to Anyone.
const HEADERS=['Event ID','Attempt ID','Team','Timestamp','Event','Section','Clue','Stage','Category','Raw answer','Result','Matched answer','Visible milliseconds','Details'];
function setup(){const s=SpreadsheetApp.getActiveSpreadsheet();if(!s)throw Error('Open Apps Script from the target Google Sheet, then run setup.');PropertiesService.getScriptProperties().setProperty('SHEET_ID',s.getId());sheet_(s,'Attempts',['Attempt ID','Team','Started','Last event','Correct','Incorrect','Repeated','Visible seconds','Full log','Inputs summary']);}
function sheet_(ss,name,headers){let s=ss.getSheetByName(name);if(s&&s.getLastRow()&&JSON.stringify(s.getRange(1,1,1,headers.length).getValues()[0])!==JSON.stringify(headers))name+=' v2';s=ss.getSheetByName(name)||ss.insertSheet(name);if(!s.getLastRow()){s.appendRow(headers);s.setFrozenRows(1);s.getRange(1,1,1,headers.length).setFontWeight('bold');}return s;}
function safe_(v){const s=String(v==null?'':v).slice(0,45000);return /^[=+@-]/.test(s)?"'"+s:s;}
function doPost(e){const lock=LockService.getScriptLock();lock.waitLock(25000);try{const ss=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID'));const body=JSON.parse(e.postData.contents);if(body.schemaVersion!==2||!Array.isArray(body.events))throw Error('Expected schemaVersion 2 events array');const master=sheet_(ss,'Attempts',['Attempt ID','Team','Started','Last event','Correct','Incorrect','Repeated','Visible seconds','Full log','Inputs summary']);const touched={};
 for(const ev of body.events.slice(0,100)){if(!ev.attemptId||!ev.eventId)continue;const id=String(ev.attemptId);let rows=master.getDataRange().getValues(),index=rows.findIndex((r,i)=>i>0&&String(r[0])===id);if(index<0){index=rows.length;master.appendRow([safe_(id),safe_(ev.team),ev.timestamp,ev.timestamp,0,0,0,0,'','']);}
 const n=index,log=sheet_(ss,'Attempt '+n+' Logs v2',HEADERS);if(log.getLastRow()>1&&log.getRange(2,1,log.getLastRow()-1,1).createTextFinder(String(ev.eventId)).matchEntireCell(true).findNext())continue;
 log.appendRow([ev.eventId,id,ev.team,ev.timestamp,ev.kind,ev.section,ev.clue,ev.stage,ev.category,ev.raw,ev.result,ev.answer,ev.durationMs||0,JSON.stringify(ev)].map(safe_));touched[id]={n,row:index+1};}
 for(const id in touched){const t=touched[id],log=ss.getSheetByName('Attempt '+t.n+' Logs v2'),data=log.getDataRange().getValues().slice(1),sum=sheet_(ss,'Attempt '+t.n+' Summary v2',['Clue','Stage','Category','Correct inputs','Incorrect inputs','Repeated inputs','Visible seconds']);let correct=0,incorrect=0,repeated=0,ms=0;const groups={};for(const r of data){const key=JSON.stringify([r[6],r[7],r[8]||'screen']);const g=groups[key]||(groups[key]={clue:r[6],stage:r[7],cat:r[8]||'screen',correct:[],incorrect:[],repeated:[],ms:0});if(r[4]==='answer'){if(r[10]==='correct'){correct++;g.correct.push(r[9]);}else if(r[10]==='incorrect'){incorrect++;g.incorrect.push(r[9]);}else if(r[10]==='repeated'){repeated++;g.repeated.push(r[9]);}}ms+=Number(r[12])||0;g.ms+=Number(r[12])||0;}
 if(sum.getLastRow()>1)sum.getRange(2,1,sum.getLastRow()-1,7).clearContent();const out=Object.values(groups).filter(g=>g.correct.length||g.incorrect.length||g.repeated.length||g.ms).map(g=>[g.clue,g.stage,g.cat,g.correct.join('\n'),g.incorrect.join('\n'),g.repeated.join('\n'),Math.round(g.ms/1000)].map(safe_));if(out.length)sum.getRange(2,1,out.length,7).setValues(out).setWrap(true);
 master.getRange(t.row,2,1,9).setValues([[safe_(data[0][2]),data[0][3],data[data.length-1][3],correct,incorrect,repeated,Math.round(ms/1000),ss.getUrl()+'#gid='+log.getSheetId(),ss.getUrl()+'#gid='+sum.getSheetId()]]);}
 return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON);
 }catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)})).setMimeType(ContentService.MimeType.JSON);}finally{lock.releaseLock();}}
